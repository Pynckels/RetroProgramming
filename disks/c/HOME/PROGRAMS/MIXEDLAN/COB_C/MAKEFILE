# Makefile for MAKE 2.0 ( Microsoft C 6.00A / MS COBOL 5.0 )

all : CRCDEMO.EXE

CRCDEMO.EXE : CRCDEMO.OBJ CRC32.OBJ
    LINK CRCDEMO.OBJ+CRC32.OBJ,CRCDEMO.EXE,NUL,COBLIB.LIB+LLIBCE.LIB;

CRCDEMO.OBJ : CRCDEMO.CBL
    COBOL CRCDEMO.CBL;

CRC32.OBJ : CRC32.C
    CL /c /AL /Gs /Zl CRC32.C

clean :
    del *.EXE
    del *.OBJ
    del *.TMP
