all: CALLPROG.EXE

CALLPROG.EXE: CALLPROG.OBJ CALLLIB.OBJ
    LINK CALLPROG.OBJ+CALLLIB.OBJ,CALLPROG.EXE,NUL,COBLIB.LIB+LLIBCE.LIB;

CALLPROG.OBJ: CALLPROG.CBL
    COBOL CALLPROG.CBL; LIST(LPT4) ASMLIST"LPT2" SOURCEASM

CALLLIB.OBJ: CALLLIB.C
    CL /c /AL /Gs /Oi /Zl CALLLIB.C
    SLEEP 1
    COPY CALLLIB.C LPT4

clean:
    del CALLPROG.EXE
    del CALLPROG.IDY
    del CALLPROG.OBJ
    del CALLLIB.OBJ

