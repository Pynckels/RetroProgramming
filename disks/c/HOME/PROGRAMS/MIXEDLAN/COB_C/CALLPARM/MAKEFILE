all: CALLPROG.EXE

CALLPROG.EXE: CALLPROG.OBJ CALLLIB.OBJ
    LINK CALLPROG.OBJ+CALLLIB.OBJ,CALLPROG.EXE,NUL,COBLIB.LIB+LLIBCE.LIB;

CALLPROG.OBJ: CALLPROG.CBL
    COBOL CALLPROG.CBL,,CALLPROG.LST; ASMLIST"" SOURCEASM
    COPY CALLPROG.GRP LPT2
    COPY CALLPROG.LST LPT4

CALLLIB.OBJ: CALLLIB.C
    CL /c /AL /Gs /Oi /Zl CALLLIB.C

clean:
    del CALLPROG.EXE
    del CALLPROG.GRP
    del CALLPROG.IDY
    del CALLPROG.LST
    del CALLPROG.OBJ
    del CALLLIB.OBJ

