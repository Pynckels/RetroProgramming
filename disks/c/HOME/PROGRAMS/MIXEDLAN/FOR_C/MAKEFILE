# Makefile for MAKE 2.0 ( Microsoft C 6.00A / MS FORTRAN 5.1 )

all : KEYSDEMO.EXE

KEYSDEMO.EXE : KEYSDEMO.OBJ KEYS.OBJ
    LINK KEYSDEMO.OBJ+KEYS.OBJ,KEYSDEMO.EXE,NUL,LLIBFORE.LIB+LLIBCE.LIB;

KEYSDEMO.OBJ : KEYSDEMO.FOR
    FL /c KEYSDEMO.FOR

KEYS.OBJ : KEYS.C
    CL /c /AL /Gs /Zl KEYS.C

clean :
    del *.EXE
    del *.OBJ
    del *.TMP
